-{"version":3,"file":"index.js","names":[],"sources":["../src/fx-auth.ts","../src/fx-resume-state.ts","../src/fx-mcp.ts","../src/fx-remote-ops.ts","../src/fx-runtime.ts","../src/fx-skills.ts","../src/fx-tools.ts","../src/fx-transport.ts","../src/fx-translate.ts","../src/fx-session.ts","../src/version.ts","../src/fx-harness.ts","../src/index.ts"],"sourcesContent":["import type { HarnessV1Authentication } from '@ai-sdk/harness';\nimport {\n  getAiGatewayAuthFromEnv,\n  isHarnessAuthenticationEnvironment,\n} from '@ai-sdk/harness/utils';\n\nexport type FxAuthenticationMode = HarnessV1Authentication;\n\nexport function resolveFxEnv({\n  auth = 'auto',\n  env = process.env,\n}: {\n  auth?: FxAuthenticationMode;\n  env?: Record<string, string | undefined>;\n} = {}): Record<string, string> {\n  const gateway = getAiGatewayAuthFromEnv({\n    env: isHarnessAuthenticationEnvironment(auth) ? auth : env,\n  });\n  return {\n    ...(gateway.apiKey ? { AI_GATEWAY_API_KEY: gateway.apiKey } : {}),\n    AI_GATEWAY_BASE_URL: gateway.baseUrl,\n  };\n}\n","import { createHash } from 'node:crypto';\nimport path from 'node:path';\nimport { shellQuote } from '@ai-sdk/harness/utils';\nimport {\n  safeParseJSON,\n  type Experimental_SandboxSession as SandboxSession,\n} from '@ai-sdk/provider-utils';\nimport type { HarnessV1PromptTurnOptions } from '@ai-sdk/harness';\nimport { z } from 'zod/v4';\nimport type { FxPrompt, FxToolResult } from './fx-runtime';\n\nconst stateFileNameSchema = z\n  .string()\n  .regex(/^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$/);\n\nexport const fxResumeStateSchema = z.object({\n  version: z.literal(1),\n  stateFileName: stateFileNameSchema,\n});\n\nexport type FxModelRecord = {\n  fingerprint: string;\n  body: string;\n  status: number;\n  complete: boolean;\n  emittedParts: number;\n  attempt: number;\n};\n\nexport type FxToolRecord = {\n  id: string;\n  name: string;\n  input: unknown;\n  status: 'waiting' | 'executing' | 'completed';\n  approvalId?: string;\n  approval?: { approved: boolean; reason?: string };\n  result?: FxToolResult;\n  output?: unknown;\n};\n\nexport type FxTurnState = {\n  id: string;\n  prompt: FxPrompt;\n  signature: string;\n  responseFormat?: HarnessV1PromptTurnOptions['responseFormat'];\n  models: FxModelRecord[];\n  tools: FxToolRecord[];\n  emittedKeys: string[];\n  steers: Array<{ text: string; beforeRequest: number }>;\n};\n\nexport type FxStoredState = {\n  version: 1;\n  sdkVersion: '0.0.13';\n  checkpoint?: string;\n  turn?: FxTurnState;\n};\n\nconst storedStateSchema = z.object({\n  version: z.literal(1),\n  sdkVersion: z.literal('0.0.13'),\n  checkpoint: z.string().optional(),\n  turn: z\n    .object({\n      id: z.string(),\n      prompt: z.union([z.string(), z.array(z.unknown())]),\n      signature: z.string(),\n      responseFormat: z.unknown().optional(),\n      models: z.array(\n        z.object({\n          fingerprint: z.string(),\n          body: z.string(),\n          status: z.number(),\n          complete: z.boolean(),\n          emittedParts: z.number().int().nonnegative(),\n          attempt: z.number().int().nonnegative(),\n        }),\n      ),\n      tools: z.array(\n        z.object({\n          id: z.string(),\n          name: z.string(),\n          input: z.unknown(),\n          status: z.enum(['waiting', 'executing', 'completed']),\n          approvalId: z.string().optional(),\n          approval: z\n            .object({ approved: z.boolean(), reason: z.string().optional() })\n            .optional(),\n          result: z\n            .object({\n              type: z.literal('libfx.tool-result'),\n              text: z.string(),\n              images: z.array(\n                z.object({\n                  type: z.literal('image'),\n                  mimeType: z.string(),\n                  data: z.string().optional(),\n                  sourceRef: z.string().optional(),\n                }),\n              ),\n              isError: z.boolean().optional(),\n            })\n            .optional(),\n          output: z.unknown().optional(),\n        }),\n      ),\n      emittedKeys: z.array(z.string()),\n      steers: z.array(\n        z.object({\n          text: z.string(),\n          beforeRequest: z.number().int().nonnegative(),\n        }),\n      ),\n    })\n    .optional(),\n});\n\nexport async function createFxStateStore(options: {\n  sandbox: SandboxSession;\n  sessionId: string;\n  workDir: string;\n  stateFileName?: string;\n}) {\n  const home = await options.sandbox.run({\n    command: `printf '%s' \"$HOME\" | base64 -w0`,\n  });\n  if (home.exitCode !== 0 || !home.stdout.trim())\n    throw new Error('Unable to resolve sandbox HOME for fx state.');\n  const homeDir = Buffer.from(home.stdout.trim(), 'base64').toString('utf8');\n  if (!path.posix.isAbsolute(homeDir))\n    throw new Error('Sandbox HOME must be absolute.');\n  const sessionKey = createHash('sha256')\n    .update(options.sessionId)\n    .digest('hex');\n  const directory = path.posix.join(\n    homeDir,\n    '.ai-sdk',\n    'harness-fx',\n    sessionKey,\n  );\n  const relative = path.posix.relative(options.workDir, directory);\n  if (\n    relative === '' ||\n    (!relative.startsWith('../') && !path.posix.isAbsolute(relative))\n  ) {\n    throw new Error('fx private state must be outside sessionWorkDir.');\n  }\n  const fileName = stateFileNameSchema.parse(\n    options.stateFileName ?? 'state.json',\n  );\n  const filePath = path.posix.join(directory, fileName);\n  const prepared = await options.sandbox.run({\n    command: `mkdir -p -- ${shellQuote(directory)} && chmod 700 -- ${shellQuote(directory)}`,\n  });\n  if (prepared.exitCode !== 0)\n    throw new Error('Unable to create private fx state directory.');\n  let writes: Promise<void> = Promise.resolve();\n  return {\n    fileName,\n    async load(): Promise<FxStoredState> {\n      const text = await options.sandbox.readTextFile({ path: filePath });\n      if (text == null)\n        throw new Error('Cannot resume fx: the saved state file is missing.');\n      const parsed = await safeParseJSON({ text, schema: storedStateSchema });\n      if (!parsed.success)\n        throw new Error(\n          'Cannot resume fx: the saved state is invalid or incompatible.',\n        );\n      return parsed.value as FxStoredState;\n    },\n    save(state: FxStoredState): Promise<void> {\n      const content = JSON.stringify(state);\n      writes = writes.then(async () => {\n        await options.sandbox.writeTextFile({\n          path: `${filePath}.tmp`,\n          content,\n        });\n        const result = await options.sandbox.run({\n          command: `mv -- ${shellQuote(`${filePath}.tmp`)} ${shellQuote(filePath)}`,\n        });\n        if (result.exitCode !== 0)\n          throw new Error(`Unable to persist fx state: ${result.stderr}`);\n      });\n      return writes;\n    },\n    flush: () => writes,\n  };\n}\n","import { HarnessCapabilityUnsupportedError } from '@ai-sdk/harness';\nimport { createMCPClient, type MCPClient } from '@ai-sdk/mcp';\nimport { z } from 'zod/v4';\nimport type { FxTool } from './fx-runtime';\n\ntype FxMcpServerConfig = {\n  url: string;\n  type?: 'http' | 'sse' | 'streamableHttp';\n  headers?: Record<string, string>;\n};\n\nconst fxMcpServerConfigSchema = z.looseObject({\n  url: z.string(),\n  type: z.enum(['http', 'sse', 'streamableHttp']).optional(),\n  headers: z.record(z.string(), z.string()).optional(),\n  disabled: z.boolean().optional(),\n});\n\nfunction parseFxMcpServerConfig({\n  serverName,\n  config,\n}: {\n  serverName: string;\n  config: unknown;\n}): FxMcpServerConfig | undefined {\n  if (\n    typeof config === 'object' &&\n    config != null &&\n    'disabled' in config &&\n    config.disabled === true\n  )\n    return undefined;\n  const parsed = fxMcpServerConfigSchema.safeParse(config);\n  if (parsed.success) return parsed.data;\n  const issue = parsed.error.issues[0];\n  if (\n    issue.path.length === 0 ||\n    ['url', 'type'].includes(String(issue.path[0]))\n  ) {\n    throw new HarnessCapabilityUnsupportedError({\n      harnessId: 'fx',\n      message: `fx MCP server ${serverName} must use an HTTP or SSE URL. Command/stdio servers are not supported.`,\n    });\n  }\n  throw new Error(\n    `Invalid fx MCP server ${serverName} field ${issue.path.join('.')}: ${issue.message}`,\n  );\n}\n\nexport type FxMcpRuntime = {\n  tools: FxTool[];\n  instructions: string;\n  close(): Promise<void>;\n};\n\nexport async function createFxMcpRuntime(options: {\n  mcpServers?: Record<string, unknown>;\n  abortSignal?: AbortSignal;\n}): Promise<FxMcpRuntime> {\n  const clients: MCPClient[] = [];\n  const tools: FxTool[] = [];\n  const instructions: string[] = [];\n  const packageName: string = 'libfx/mcp';\n  const { createMcpAdapter } = (await import(packageName)) as {\n    createMcpAdapter(\n      client: unknown,\n      options: { prefix: string },\n    ): Promise<{ tools: FxTool[] }>;\n  };\n  const close = async () => {\n    await Promise.all(clients.map(client => client.close()));\n  };\n  try {\n    for (const [serverName, rawConfig] of Object.entries(\n      options.mcpServers ?? {},\n    )) {\n      const config = parseFxMcpServerConfig({ serverName, config: rawConfig });\n      if (!config) continue;\n      const client = await createMCPClient({\n        transport: {\n          type: config.type === 'sse' ? 'sse' : 'http',\n          url: config.url,\n          headers: config.headers,\n        },\n        initializationOptions: { signal: options.abortSignal },\n      });\n      clients.push(client);\n      if (client.instructions) instructions.push(client.instructions);\n      const adapter = await createMcpAdapter(\n        {\n          listTools: (input?: { cursor?: string }) =>\n            client.listTools({ params: input }),\n          callTool: (\n            input: { name: string; arguments?: Record<string, unknown> },\n            _unused: unknown,\n            context: { signal: AbortSignal },\n          ) =>\n            client.callTool({ ...input, options: { signal: context.signal } }),\n        },\n        { prefix: `mcp_${serverName.replace(/[^A-Za-z0-9_-]/g, '_')}_` },\n      );\n      tools.push(...adapter.tools);\n    }\n  } catch (error) {\n    await close().catch(() => {});\n    throw error;\n  }\n  return { tools, instructions: instructions.join('\\n\\n'), close };\n}\n","import path from 'node:path';\nimport { shellQuote } from '@ai-sdk/harness/utils';\nimport type { Experimental_SandboxSession as SandboxSession } from '@ai-sdk/provider-utils';\n\nexport function createFxRemoteOps(options: {\n  sandbox: SandboxSession;\n  workDir: string;\n}) {\n  const { sandbox } = options;\n  const workDir = path.posix.resolve(options.workDir);\n  let canonicalRoot: Promise<string> | undefined;\n\n  function assertContained(input: { root: string; candidate: string }): string {\n    const relative = path.posix.relative(input.root, input.candidate);\n    if (\n      relative === '..' ||\n      relative.startsWith('../') ||\n      path.posix.isAbsolute(relative)\n    ) {\n      throw new Error(`fx path escapes the workspace: ${input.candidate}`);\n    }\n    return input.candidate;\n  }\n\n  async function run(input: { command: string; signal?: AbortSignal }) {\n    input.signal?.throwIfAborted();\n    return sandbox.run({\n      command: input.command,\n      workingDirectory: workDir,\n      ...(input.signal ? { abortSignal: input.signal } : {}),\n    });\n  }\n\n  async function realpath(input: {\n    target: string;\n    signal?: AbortSignal;\n  }): Promise<string> {\n    const result = await run({\n      command: `bash -o pipefail -c ${shellQuote(`realpath -mz -- ${shellQuote(input.target)} | base64`)}`,\n      signal: input.signal,\n    });\n    if (result.exitCode !== 0 || !result.stdout.trim()) {\n      throw new Error(`Unable to resolve sandbox path: ${input.target}`);\n    }\n    const decoded = Buffer.from(result.stdout.trim(), 'base64').toString(\n      'utf8',\n    );\n    return decoded.endsWith('\\0') ? decoded.slice(0, -1) : decoded;\n  }\n\n  async function resolvePath(input: {\n    filePath: string;\n    signal?: AbortSignal;\n  }): Promise<string> {\n    const candidate = assertContained({\n      root: workDir,\n      candidate: path.posix.resolve(workDir, input.filePath),\n    });\n    canonicalRoot ??= realpath({ target: workDir });\n    return assertContained({\n      root: await canonicalRoot,\n      candidate: await realpath({ target: candidate, signal: input.signal }),\n    });\n  }\n\n  async function read(input: { file_path: string; signal?: AbortSignal }) {\n    const filePath = await resolvePath({\n      filePath: input.file_path,\n      signal: input.signal,\n    });\n    const content = await sandbox.readTextFile({\n      path: filePath,\n      abortSignal: input.signal,\n    });\n    if (content == null) throw new Error(`File not found: ${input.file_path}`);\n    return content;\n  }\n\n  async function write(input: {\n    file_path: string;\n    content: string;\n    signal?: AbortSignal;\n  }) {\n    const filePath = await resolvePath({\n      filePath: input.file_path,\n      signal: input.signal,\n    });\n    await sandbox.writeTextFile({\n      path: filePath,\n      content: input.content,\n      abortSignal: input.signal,\n    });\n    return `Wrote ${input.file_path}`;\n  }\n\n  async function edit(input: {\n    file_path: string;\n    old_string: string;\n    new_string: string;\n    signal?: AbortSignal;\n  }) {\n    const content = await read(input);\n    const index = content.indexOf(input.old_string);\n    if (index === -1 || input.old_string.length === 0)\n      throw new Error('Text to replace was not found or is empty.');\n    if (content.includes(input.old_string, index + input.old_string.length)) {\n      throw new Error(\n        'Text to replace occurs more than once. Include more context.',\n      );\n    }\n    await write({\n      ...input,\n      content:\n        content.slice(0, index) +\n        input.new_string +\n        content.slice(index + input.old_string.length),\n    });\n    return `Edited ${input.file_path}`;\n  }\n\n  async function bash(input: {\n    command: string;\n    timeout?: number;\n    signal?: AbortSignal;\n  }) {\n    const signal =\n      input.timeout != null && input.timeout > 0\n        ? AbortSignal.any([\n            ...(input.signal ? [input.signal] : []),\n            AbortSignal.timeout(input.timeout * 1000),\n          ])\n        : input.signal;\n    return run({ command: input.command, signal });\n  }\n\n  async function grep(input: {\n    pattern: string;\n    path?: string;\n    glob?: string;\n    ignoreCase?: boolean;\n    literal?: boolean;\n    context?: number;\n    limit?: number;\n    signal?: AbortSignal;\n  }) {\n    const target = await resolvePath({\n      filePath: input.path ?? '.',\n      signal: input.signal,\n    });\n    const flags = [\n      '-r',\n      '-n',\n      '--binary-files=without-match',\n      ...(input.ignoreCase ? ['-i'] : []),\n      ...(input.literal ? ['-F'] : []),\n      ...(input.glob ? [`--include=${input.glob}`] : []),\n      ...(input.context ? ['-C', String(input.context)] : []),\n    ];\n    const result = await run({\n      command: `grep ${flags.map(shellQuote).join(' ')} -- ${shellQuote(input.pattern)} ${shellQuote(target)} | head -n ${Math.max(1, Math.floor(input.limit ?? 100))}`,\n      signal: input.signal,\n    });\n    return result.stdout || result.stderr || 'No matches found';\n  }\n\n  async function glob(input: {\n    pattern: string;\n    path?: string;\n    limit?: number;\n    signal?: AbortSignal;\n  }) {\n    const target = await resolvePath({\n      filePath: input.path ?? '.',\n      signal: input.signal,\n    });\n    const result = await run({\n      command: `find ${shellQuote(target)} -type f -print0`,\n      signal: input.signal,\n    });\n    if (result.exitCode !== 0) throw new Error(result.stderr);\n    return result.stdout\n      .split('\\0')\n      .filter(Boolean)\n      .map(file => path.posix.relative(target, file))\n      .filter(file => path.matchesGlob(file, input.pattern))\n      .sort()\n      .slice(0, input.limit ?? 1000);\n  }\n\n  async function ls(input: {\n    path?: string;\n    limit?: number;\n    signal?: AbortSignal;\n  }) {\n    const target = await resolvePath({\n      filePath: input.path ?? '.',\n      signal: input.signal,\n    });\n    const result = await run({\n      command: `find ${shellQuote(target)} -mindepth 1 -maxdepth 1 -printf '%f\\\\0'`,\n      signal: input.signal,\n    });\n    if (result.exitCode !== 0) throw new Error(result.stderr);\n    return result.stdout\n      .split('\\0')\n      .filter(Boolean)\n      .sort()\n      .slice(0, input.limit ?? 500);\n  }\n\n  return { read, write, edit, bash, grep, glob, ls };\n}\n\nexport type FxRemoteOps = ReturnType<typeof createFxRemoteOps>;\n","export type FxToolResult = {\n  type: 'libfx.tool-result';\n  text: string;\n  images: Array<{\n    type: 'image';\n    mimeType: string;\n    data?: string;\n    sourceRef?: string;\n  }>;\n  isError?: boolean;\n};\n\nexport type FxTool = {\n  name: string;\n  description: string;\n  inputSchema: unknown;\n  execute: (\n    input: unknown,\n    context: { signal: AbortSignal },\n  ) => Promise<unknown>;\n};\n\nexport type FxRuntimeEvent =\n  | { type: 'text_delta' | 'reasoning_delta'; delta: string }\n  | {\n      type: 'tool_start';\n      id: string;\n      name: string;\n      input?: unknown;\n      inputTruncated?: boolean;\n    }\n  | {\n      type: 'tool_end';\n      id: string;\n      name: string;\n      content?: string;\n      isError?: boolean;\n    }\n  | { type: 'user_message'; text: string };\n\nexport type FxPrompt =\n  | string\n  | Array<{\n      type: 'text' | 'image';\n      text?: string;\n      data?: string;\n      mimeType?: string;\n    }>;\n\nexport type FxTurn = AsyncIterable<FxRuntimeEvent> & {\n  cancel(): void;\n  steer(text: string): Promise<unknown>;\n  result: Promise<{ stopReason: string; usage?: Record<string, number> }>;\n};\n\nexport type FxAgent = {\n  prompt(input: FxPrompt, options?: { signal?: AbortSignal }): FxTurn;\n  checkpoint(): Promise<Uint8Array>;\n  close(): Promise<void>;\n};\n\nexport type FxRuntimeOptions = {\n  apiKey: string;\n  model?:\n    | string\n    | { id: string; effort?: string; fast?: boolean; ultrafast?: boolean };\n  effort?: string;\n  fast?: boolean;\n  ultrafast?: boolean;\n  instructions?: string;\n  tools: FxTool[];\n  checkpoint?: Uint8Array;\n  fetch: typeof globalThis.fetch;\n  backend?: 'auto' | 'native' | 'wasm';\n  onEvent?: (event: { type: string; message?: unknown }) => void;\n};\n\n/*\n * The pinned stable SDK ships JavaScript without declarations. Keeping its\n * small, source-verified boundary here avoids ambient declarations and keeps\n * upstream implementation types out of the package's public API.\n */\nexport async function createFxRuntime(\n  options: FxRuntimeOptions,\n): Promise<FxAgent> {\n  const packageName: string = 'libfx';\n  const runtime = (await import(packageName)) as {\n    createFxAgent(options: FxRuntimeOptions): Promise<FxAgent>;\n  };\n  return runtime.createFxAgent(options);\n}\n","import type { HarnessV1Skill } from '@ai-sdk/harness';\n\nexport async function createFxSkillsRuntime({\n  skills,\n}: {\n  skills: ReadonlyArray<HarnessV1Skill>;\n}): Promise<{ instructions: string; signature: string }> {\n  const packageName: string = 'libfx/skills';\n  const { createSkillsAdapter } = (await import(packageName)) as {\n    createSkillsAdapter(\n      records: Array<{\n        name: string;\n        description: string;\n        instructions: string;\n        resources: Array<{ uri: string; text: string }>;\n      }>,\n    ): { instructions: string };\n  };\n  const { instructions } = createSkillsAdapter(\n    skills.map(skill => ({\n      name: skill.name,\n      description: skill.description,\n      instructions: skill.content,\n      resources: (skill.files ?? []).map(file => ({\n        uri: file.path,\n        text: file.content,\n      })),\n    })),\n  );\n  return { instructions, signature: instructions };\n}\n","import type {\n  HarnessV1PermissionMode,\n  HarnessV1PromptControl,\n} from '@ai-sdk/harness';\nimport {\n  convertHarnessToolModelOutput,\n  normalizeHarnessToolModelOutput,\n} from '@ai-sdk/harness/utils';\nimport { secureJsonParse } from '@ai-sdk/provider-utils';\nimport type { JSONValue } from '@ai-sdk/provider';\nimport type { FxToolResult } from './fx-runtime';\n\nexport type FxToolSubmission = Parameters<\n  HarnessV1PromptControl['submitToolResult']\n>[0];\n\nexport function fxToolRequiresApproval(options: {\n  permissionMode: HarnessV1PermissionMode;\n  kind: 'readonly' | 'edit' | 'bash';\n}): boolean {\n  return (\n    options.permissionMode !== 'allow-all' &&\n    (options.kind === 'bash' ||\n      (options.kind === 'edit' && options.permissionMode === 'allow-reads'))\n  );\n}\n\nexport function fxJsonValue(value: unknown): JSONValue {\n  if (value == null) return null;\n  try {\n    const serialized = JSON.stringify(value);\n    return serialized === undefined\n      ? String(value)\n      : (secureJsonParse(serialized) as JSONValue);\n  } catch {\n    return String(value);\n  }\n}\n\nexport function toFxToolResult(submission: FxToolSubmission): FxToolResult {\n  const output = submission.toolResult?.output;\n  const result: FxToolResult = {\n    type: 'libfx.tool-result',\n    text: '',\n    images: [],\n    isError: submission.isError,\n  };\n  if (output == null) {\n    result.text =\n      typeof submission.output === 'string'\n        ? submission.output\n        : JSON.stringify(fxJsonValue(submission.output));\n    return result;\n  }\n  const converted = convertHarnessToolModelOutput({\n    output: normalizeHarnessToolModelOutput({\n      output:\n        output.type === 'execution-denied'\n          ? { ...output, reason: output.reason ?? 'Tool execution was denied.' }\n          : output,\n    }),\n  });\n  const text: string[] = [];\n  for (const part of converted.content) {\n    if (part.type === 'text') {\n      if (part.text) text.push(part.text);\n    } else {\n      result.images.push({\n        type: 'image',\n        data: part.data,\n        mimeType: part.mediaType,\n      });\n    }\n  }\n  result.text = text.join('\\n');\n  result.isError = converted.isError\n    ? true\n    : output.type === 'content'\n      ? submission.isError\n      : Boolean(submission.isError);\n  return result;\n}\n","import { createHash } from 'node:crypto';\nimport { secureJsonParse } from '@ai-sdk/provider-utils';\nimport type { HarnessV1ResponseFormat } from '@ai-sdk/harness';\nimport type { FxModelRecord, FxTurnState } from './fx-resume-state';\n\nexport type FxGatewayPart = { type: string; [key: string]: unknown };\n\nexport function parseFxEvent(frame: string): FxGatewayPart | undefined {\n  const data = frame\n    .split(/\\r?\\n/)\n    .filter(line => line.startsWith('data:'))\n    .map(line => line.slice(5).trimStart())\n    .join('\\n');\n  if (!data || data === '[DONE]') return undefined;\n  return secureJsonParse(data) as FxGatewayPart;\n}\n\nexport function createFxTransport(options: {\n  baseUrl: string;\n  headers: Record<string, string>;\n  turn: FxTurnState;\n  responseFormat?: HarnessV1ResponseFormat;\n  save(): Promise<void>;\n  onPart(input: {\n    part: FxGatewayPart;\n    requestIndex: number;\n    attempt: number;\n    replay: boolean;\n    suppress: boolean;\n  }): void;\n  onRequest(input: { requestIndex: number; modelId?: string }): void;\n  beforeRelease(input: {\n    requestIndex: number;\n    replay: boolean;\n  }): void | Promise<void>;\n  fetch?: typeof globalThis.fetch;\n}) {\n  let requestIndex = -1;\n  let active = true;\n  const tasks = new Set<Promise<void>>();\n  const networkFetch = options.fetch ?? globalThis.fetch;\n\n  const wrappedFetch: typeof globalThis.fetch = async (input, init = {}) => {\n    if (!active) throw new DOMException('fx turn is suspended.', 'AbortError');\n    const originalUrl = new URL(\n      input instanceof Request ? input.url : String(input),\n    );\n    const url = new URL(originalUrl);\n    const base = new URL(\n      options.baseUrl.endsWith('/') ? options.baseUrl : `${options.baseUrl}/`,\n    );\n    if (originalUrl.origin === 'https://ai-gateway.vercel.sh') {\n      url.href = new URL(\n        originalUrl.pathname.slice(1) + originalUrl.search,\n        base,\n      ).href;\n    }\n    const headers = new Headers(\n      init.headers ?? (input instanceof Request ? input.headers : undefined),\n    );\n    for (const [name, value] of Object.entries(options.headers))\n      headers.set(name, value);\n    const method = (\n      init.method ?? (input instanceof Request ? input.method : 'GET')\n    ).toUpperCase();\n    if (\n      method !== 'POST' ||\n      !originalUrl.pathname.endsWith('/ai/language-model')\n    ) {\n      if (!(input instanceof Request)) {\n        return networkFetch(url, { ...init, headers });\n      }\n      /*\n       * Retargeting a Request exposes its body as a stream, which cannot be\n       * supplied with keepalive enabled. Restore keepalive through fetch init,\n       * where the body is inherited from the Request instead of supplied anew.\n       */\n      const request = new Request(\n        url,\n        new Request(input, { keepalive: false }),\n      );\n      return networkFetch(request, {\n        keepalive: input.keepalive,\n        referrer: input.referrer,\n        referrerPolicy: input.referrerPolicy,\n        ...init,\n        headers,\n      });\n    }\n    const index = ++requestIndex;\n    const inputBody =\n      typeof init.body === 'string'\n        ? init.body\n        : init.body instanceof Uint8Array\n          ? new TextDecoder().decode(init.body)\n          : input instanceof Request\n            ? await input.clone().text()\n            : String(init.body ?? '');\n    const body =\n      options.responseFormat?.type === 'json'\n        ? JSON.stringify({\n            ...(secureJsonParse(inputBody) as object),\n            responseFormat: options.responseFormat,\n          })\n        : inputBody;\n    const fingerprint = createHash('sha256')\n      .update(\n        JSON.stringify({\n          path: originalUrl.pathname,\n          model: headers.get('ai-language-model-id'),\n          body,\n        }),\n      )\n      .digest('hex');\n    options.onRequest({\n      requestIndex: index,\n      modelId: headers.get('ai-language-model-id') ?? undefined,\n    });\n    const previous = options.turn.models[index];\n    if (previous && previous.fingerprint !== fingerprint) {\n      throw new Error(\n        `fx continuation diverged at model request ${index}. Refusing to replay different work.`,\n      );\n    }\n\n    function deliver(input: {\n      frame: string;\n      record: FxModelRecord;\n      replay: boolean;\n      partIndex: number;\n    }) {\n      const part = parseFxEvent(input.frame);\n      if (part) {\n        options.onPart({\n          part,\n          requestIndex: index,\n          attempt: input.record.attempt,\n          replay: input.replay,\n          suppress: input.replay && input.partIndex < input.record.emittedParts,\n        });\n      }\n      if (!input.replay || input.partIndex >= input.record.emittedParts) {\n        input.record.emittedParts = input.partIndex + 1;\n      }\n    }\n\n    if (previous?.complete) {\n      if (previous.status < 200 || previous.status >= 300) {\n        return new Response(previous.body, { status: previous.status });\n      }\n      let partIndex = 0;\n      for (const frame of previous.body.split(/\\r?\\n\\r?\\n/)) {\n        if (frame)\n          deliver({\n            frame,\n            record: previous,\n            replay: true,\n            partIndex: partIndex++,\n          });\n      }\n      await options.beforeRelease({ requestIndex: index, replay: true });\n      await options.save();\n      if (!active)\n        throw new DOMException('fx turn is suspended.', 'AbortError');\n      return new Response(previous.body, {\n        status: previous.status,\n        headers: { 'content-type': 'text/event-stream' },\n      });\n    }\n\n    const record: FxModelRecord = {\n      fingerprint,\n      body: '',\n      status: 200,\n      complete: false,\n      emittedParts: 0,\n      attempt: previous ? previous.attempt + 1 : 0,\n    };\n    options.turn.models[index] = record;\n    await options.save();\n    let response: Response;\n    try {\n      response = await networkFetch(url, {\n        ...init,\n        method,\n        headers,\n        body,\n      });\n    } catch (error) {\n      if (previous) options.turn.models[index] = previous;\n      else options.turn.models.splice(index, 1);\n      requestIndex--;\n      await options.save();\n      throw error;\n    }\n    record.status = response.status;\n    if (!response.ok || !response.body) {\n      record.body = await response.text();\n      record.complete = true;\n      await options.save();\n      return new Response(record.body, {\n        status: response.status,\n        headers: response.headers,\n      });\n    }\n\n    const stream = new TransformStream<Uint8Array, Uint8Array>();\n    const writer = stream.writable.getWriter();\n    const reader = response.body.getReader();\n    const decoder = new TextDecoder();\n    const encoder = new TextEncoder();\n    const pump = (async () => {\n      let pending = '';\n      let holding = false;\n      let terminal = false;\n      let held = '';\n      let partIndex = 0;\n      try {\n        for (;;) {\n          const { value, done } = await reader.read();\n          if (!active)\n            throw new DOMException('fx turn is suspended.', 'AbortError');\n          const chunk = done\n            ? decoder.decode()\n            : decoder.decode(value, { stream: true });\n          record.body += chunk;\n          pending += chunk;\n          let match: RegExpMatchArray | null;\n          while ((match = pending.match(/\\r?\\n\\r?\\n/)) != null) {\n            const end = match.index! + match[0].length;\n            const frame = pending.slice(0, end);\n            pending = pending.slice(end);\n            const part = parseFxEvent(frame);\n            if (part?.type === 'finish' || part?.type === 'error')\n              terminal = true;\n            if (\n              part &&\n              (part.type.startsWith('tool-') ||\n                part.type === 'finish' ||\n                part.type === 'error')\n            )\n              holding = true;\n            if (holding) held += frame;\n            else {\n              deliver({ frame, record, replay: false, partIndex });\n              await writer.write(encoder.encode(frame));\n            }\n            partIndex++;\n          }\n          if (done) break;\n        }\n        if (pending.trim())\n          throw new Error('Gateway stream ended with an incomplete event.');\n        if (!terminal)\n          throw new Error('Gateway stream ended before a terminal event.');\n        record.complete = true;\n        await options.save();\n        let heldIndex = record.emittedParts;\n        for (const frame of held.split(/\\r?\\n\\r?\\n/)) {\n          if (frame)\n            deliver({ frame, record, replay: false, partIndex: heldIndex++ });\n        }\n        await options.beforeRelease({ requestIndex: index, replay: false });\n        await options.save();\n        if (!active)\n          throw new DOMException('fx turn is suspended.', 'AbortError');\n        if (held) await writer.write(encoder.encode(held));\n        await writer.close();\n      } catch (error) {\n        await reader.cancel(error).catch(() => {});\n        await writer.abort(error).catch(() => {});\n        throw error;\n      } finally {\n        reader.releaseLock();\n      }\n    })();\n    tasks.add(pump);\n    void pump.catch(() => {}).finally(() => tasks.delete(pump));\n    return new Response(stream.readable, {\n      status: response.status,\n      headers: response.headers,\n    });\n  };\n\n  return {\n    fetch: wrappedFetch,\n    get requestIndex() {\n      return requestIndex;\n    },\n    async stop() {\n      active = false;\n      await Promise.allSettled([...tasks]);\n    },\n  };\n}\n","import type { HarnessV1StreamPart } from '@ai-sdk/harness';\nimport type {\n  LanguageModelV4FinishReason,\n  LanguageModelV4Usage,\n} from '@ai-sdk/provider';\nimport type { FxGatewayPart } from './fx-transport';\n\nexport type FxGatewayToolCall = {\n  toolCallId: string;\n  toolName: string;\n  input: unknown;\n};\n\nexport function emptyFxUsage(): LanguageModelV4Usage {\n  return {\n    inputTokens: {\n      total: undefined,\n      noCache: undefined,\n      cacheRead: undefined,\n      cacheWrite: undefined,\n    },\n    outputTokens: { total: undefined, text: undefined, reasoning: undefined },\n  };\n}\n\nexport function createFxTranslator(options: {\n  turnId: string;\n  emit(part: HarnessV1StreamPart): void;\n}) {\n  const toolCalls = new Map<number, FxGatewayToolCall[]>();\n  const steps = new Map<\n    number,\n    { finishReason: LanguageModelV4FinishReason; usage: LanguageModelV4Usage }\n  >();\n  function onPart(input: {\n    part: FxGatewayPart;\n    requestIndex: number;\n    attempt: number;\n    suppress: boolean;\n  }) {\n    const { part } = input;\n    if (\n      part.type === 'tool-call' &&\n      part.providerExecuted !== true &&\n      typeof part.toolCallId === 'string' &&\n      typeof part.toolName === 'string'\n    ) {\n      const calls = toolCalls.get(input.requestIndex) ?? [];\n      if (!calls.some(call => call.toolCallId === part.toolCallId)) {\n        calls.push({\n          toolCallId: part.toolCallId,\n          toolName: part.toolName,\n          input: part.input,\n        });\n      }\n      toolCalls.set(input.requestIndex, calls);\n    }\n    if (part.type === 'finish') {\n      steps.set(input.requestIndex, {\n        finishReason: part.finishReason as LanguageModelV4FinishReason,\n        usage: (part.usage as LanguageModelV4Usage) ?? emptyFxUsage(),\n      });\n    }\n    if (input.suppress) return;\n    const id = `${options.turnId}:${input.requestIndex}:${input.attempt}:${String(part.id ?? '0')}`;\n    switch (part.type) {\n      case 'text-start':\n      case 'text-end':\n      case 'reasoning-start':\n      case 'reasoning-end':\n        options.emit({ type: part.type, id });\n        break;\n      case 'text-delta':\n      case 'reasoning-delta':\n        options.emit({ type: part.type, id, delta: String(part.delta ?? '') });\n        break;\n      case 'error':\n        options.emit({ type: 'error', error: part.error });\n        break;\n    }\n  }\n  function totalUsage(): LanguageModelV4Usage {\n    const total = emptyFxUsage();\n    for (const step of steps.values()) {\n      for (const group of ['inputTokens', 'outputTokens'] as const) {\n        const target = total[group] as Record<string, number | undefined>;\n        for (const [key, value] of Object.entries(step.usage[group])) {\n          if (typeof value === 'number')\n            target[key] = (target[key] ?? 0) + value;\n        }\n      }\n    }\n    return total;\n  }\n  return { onPart, steps, toolCalls, totalUsage };\n}\n","import { createHash, randomUUID } from 'node:crypto';\nimport {\n  HarnessCapabilityUnsupportedError,\n  isHarnessV1BuiltinToolIncluded,\n  type HarnessV1BuiltinTool,\n  type HarnessV1ContinueTurnOptions,\n  type HarnessV1ContinueTurnState,\n  type HarnessV1PromptControl,\n  type HarnessV1PromptTurnOptions,\n  type HarnessV1Session,\n  type HarnessV1StartOptions,\n  type HarnessV1StreamPart,\n} from '@ai-sdk/harness';\nimport { getRestrictedSandboxSession } from '@ai-sdk/harness/utils';\nimport { asSchema, secureJsonParse } from '@ai-sdk/provider-utils';\nimport type { FxHarnessSettings } from './fx-harness';\nimport { createFxMcpRuntime } from './fx-mcp';\nimport { createFxRemoteOps } from './fx-remote-ops';\nimport {\n  createFxStateStore,\n  fxResumeStateSchema,\n  type FxStoredState,\n  type FxToolRecord,\n} from './fx-resume-state';\nimport {\n  createFxRuntime,\n  type FxAgent,\n  type FxPrompt,\n  type FxTool,\n  type FxToolResult,\n  type FxTurn,\n} from './fx-runtime';\nimport { createFxSkillsRuntime } from './fx-skills';\nimport {\n  fxJsonValue,\n  fxToolRequiresApproval,\n  toFxToolResult,\n  type FxToolSubmission,\n} from './fx-tools';\nimport { createFxTransport } from './fx-transport';\nimport { createFxTranslator, emptyFxUsage } from './fx-translate';\n\ntype FxRegisteredTool = {\n  providerExecuted: boolean;\n  kind: 'readonly' | 'edit' | 'bash';\n};\n\nfunction toPrompt(prompt: HarnessV1PromptTurnOptions['prompt']): FxPrompt {\n  if (typeof prompt === 'string') return prompt;\n  if (typeof prompt.content === 'string') return prompt.content;\n  return prompt.content.map(part => {\n    if (part.type === 'text') return { type: 'text' as const, text: part.text };\n    if (\n      part.type === 'image' &&\n      (typeof part.image === 'string' ||\n        part.image instanceof Uint8Array ||\n        part.image instanceof ArrayBuffer)\n    ) {\n      return {\n        type: 'image' as const,\n        data:\n          typeof part.image === 'string'\n            ? part.image\n            : Buffer.from(\n                part.image instanceof ArrayBuffer\n                  ? new Uint8Array(part.image)\n                  : part.image,\n              ).toString('base64'),\n        mimeType: part.mediaType ?? 'image/png',\n      };\n    }\n    throw new HarnessCapabilityUnsupportedError({\n      harnessId: 'fx',\n      message:\n        'fx prompts support text and inline images, not files or image URLs.',\n    });\n  });\n}\n\nexport async function createFxSession(options: {\n  startOpts: HarnessV1StartOptions;\n  settings: FxHarnessSettings;\n  environment: Record<string, string>;\n  builtinTools: Record<string, HarnessV1BuiltinTool<any, any>>;\n  clientApp: string;\n}): Promise<HarnessV1Session> {\n  const { startOpts, settings } = options;\n  startOpts.abortSignal?.throwIfAborted();\n  const apiKey = options.environment.AI_GATEWAY_API_KEY;\n  if (!apiKey) {\n    throw new Error(\n      'fx requires AI_GATEWAY_API_KEY or VERCEL_OIDC_TOKEN in the host environment or an explicit authentication environment.',\n    );\n  }\n  const resume =\n    startOpts.continueFrom ??\n    startOpts.resumeFrom?.continueFrom ??\n    startOpts.resumeFrom;\n  if (\n    resume &&\n    (resume.harnessId !== 'fx' || resume.specificationVersion !== 'harness-v1')\n  ) {\n    throw new Error('Cannot import lifecycle state from a different harness.');\n  }\n  const sandbox = getRestrictedSandboxSession(startOpts.sandboxSession);\n  const store = await createFxStateStore({\n    sandbox,\n    sessionId: startOpts.sessionId,\n    workDir: startOpts.sessionWorkDir,\n    stateFileName: resume\n      ? fxResumeStateSchema.parse(resume.data).stateFileName\n      : undefined,\n  });\n  const state: FxStoredState = resume\n    ? await store.load()\n    : { version: 1, sdkVersion: '0.0.13' };\n  const remote = createFxRemoteOps({\n    sandbox,\n    workDir: startOpts.sessionWorkDir,\n  });\n  const save = () => store.save(state);\n  await save();\n  let stopped = false;\n  let active:\n    | {\n        suspend(): Promise<void>;\n        done: Promise<void>;\n        control: HarnessV1PromptControl;\n        attach(emit: (part: HarnessV1StreamPart) => void): void;\n      }\n    | undefined;\n\n  async function runTurn(input: {\n    turnOptions: HarnessV1PromptTurnOptions | HarnessV1ContinueTurnOptions;\n    continuing: boolean;\n  }): Promise<HarnessV1PromptControl> {\n    if (stopped) throw new Error('fx session has been stopped.');\n    if (active && !state.turn) await active.done.catch(() => {});\n    const opts = input.turnOptions;\n    const serviceTierOptions =\n      settings.serviceTier === undefined || settings.serviceTier === 'default'\n        ? undefined\n        : {\n            fast: settings.serviceTier === 'fast',\n            ultrafast: settings.serviceTier === 'ultrafast',\n          };\n    const signature = createHash('sha256')\n      .update(\n        JSON.stringify({\n          model: opts.model,\n          skills: opts.skills,\n          instructions: opts.instructions,\n          tools: opts.tools,\n          responseFormat: opts.responseFormat,\n          filtering: startOpts.builtinToolFiltering,\n          permissionMode: startOpts.permissionMode,\n          mcpServers: settings.mcpServers,\n          effort: settings.effort,\n          fast: serviceTierOptions?.fast,\n          ultrafast: serviceTierOptions?.ultrafast,\n        }),\n      )\n      .digest('hex');\n    if (input.continuing) {\n      if (!state.turn)\n        throw new Error('There is no suspended fx turn to continue.');\n      if (state.turn.signature !== signature)\n        throw new Error(\n          'Cannot change fx settings while continuing an unfinished turn.',\n        );\n      if (active) {\n        active.attach(opts.emit);\n        return active.control;\n      }\n    } else {\n      if (state.turn)\n        throw new Error(\n          'Continue the unfinished fx turn before prompting again.',\n        );\n      state.turn = {\n        id: randomUUID(),\n        prompt: toPrompt((opts as HarnessV1PromptTurnOptions).prompt),\n        signature,\n        responseFormat: opts.responseFormat,\n        models: [],\n        tools: [],\n        emittedKeys: [],\n        steers: [],\n      };\n    }\n    const turnState = state.turn!;\n    const emitted = new Set(turnState.emittedKeys);\n    let suspending = false;\n    const controller = new AbortController();\n    const signal = opts.abortSignal\n      ? AbortSignal.any([controller.signal, opts.abortSignal])\n      : controller.signal;\n    let runtime: FxAgent | undefined;\n    let runtimeTurn: FxTurn | undefined;\n    let transport: ReturnType<typeof createFxTransport> | undefined;\n    let mcp: Awaited<ReturnType<typeof createFxMcpRuntime>> | undefined;\n    const results = new Map<string, FxToolSubmission>();\n    const approvals = new Map<string, { approved: boolean; reason?: string }>();\n    const registeredTools = new Map<string, FxRegisteredTool>();\n    const toolRequests = new Map<string, number>();\n    const wake = new Set<() => void>();\n    const identities: Array<{ id: string; name: string }> = [];\n    const seenIdentities = new Set<string>();\n    let callbackIndex = 0;\n    const replaySteers = [...turnState.steers];\n    const pendingSteers: string[] = [];\n    function recordSteer(text: string) {\n      const index = pendingSteers.indexOf(text);\n      if (index === -1) return;\n      pendingSteers.splice(index, 1);\n      turnState.steers.push({\n        text,\n        beforeRequest: (transport?.requestIndex ?? -1) + 1,\n      });\n    }\n    let emitTarget = opts.emit;\n    const emit = (part: HarnessV1StreamPart) => {\n      if (!suspending) emitTarget(part);\n    };\n    function emitOnce(input: { key: string; part: HarnessV1StreamPart }) {\n      if (suspending || emitted.has(input.key)) return;\n      emitted.add(input.key);\n      turnState.emittedKeys.push(input.key);\n      emit(input.part);\n    }\n    const translator = createFxTranslator({ turnId: turnState.id, emit });\n    function flushStep(requestIndex: number) {\n      const step = translator.steps.get(requestIndex);\n      if (step)\n        emitOnce({\n          key: `step:${requestIndex}`,\n          part: { type: 'finish-step', ...step },\n        });\n    }\n    function notify() {\n      for (const resolve of wake) resolve();\n      wake.clear();\n    }\n    async function waitFor<T>(get: () => T | undefined): Promise<T> {\n      for (;;) {\n        signal.throwIfAborted();\n        const value = get();\n        if (value !== undefined) return value;\n        await new Promise<void>(resolve => {\n          const finish = () => {\n            signal.removeEventListener('abort', finish);\n            wake.delete(finish);\n            resolve();\n          };\n          wake.add(finish);\n          signal.addEventListener('abort', finish, { once: true });\n          if (signal.aborted) finish();\n        });\n      }\n    }\n    function earlyStep(record: FxToolRecord) {\n      const requestIndex = toolRequests.get(record.id);\n      emitOnce({\n        key:\n          requestIndex === undefined\n            ? `waiting:${record.id}`\n            : `waiting-step:${requestIndex}`,\n        part: {\n          type: 'finish-step',\n          finishReason: { unified: 'tool-calls', raw: undefined },\n          usage: emptyFxUsage(),\n        },\n      });\n    }\n    function getToolRecord(input: {\n      id: string;\n      name: string;\n      value: unknown;\n    }): FxToolRecord {\n      const record = turnState.tools.find(item => item.id === input.id);\n      if (record) {\n        if (\n          record.name !== input.name ||\n          JSON.stringify(record.input) !== JSON.stringify(input.value)\n        )\n          throw new Error('fx continuation changed a recorded tool call.');\n        return record;\n      }\n      const created: FxToolRecord = {\n        id: input.id,\n        name: input.name,\n        input: fxJsonValue(input.value),\n        status: 'waiting',\n      };\n      turnState.tools.push(created);\n      return created;\n    }\n    function emitToolCall(input: {\n      record: FxToolRecord;\n      providerExecuted: boolean;\n    }) {\n      const { record, providerExecuted } = input;\n      emitOnce({\n        key: `call:${record.id}`,\n        part: {\n          type: 'tool-call',\n          toolCallId: record.id,\n          toolName: record.name,\n          input: JSON.stringify(record.input),\n          providerExecuted,\n          ...(record.name.startsWith('mcp_') ? { dynamic: true } : {}),\n          ...(providerExecuted ? { nativeName: record.name } : {}),\n        },\n      });\n    }\n    function emitToolApproval(record: FxToolRecord) {\n      record.approvalId ??= `fx:${record.id}`;\n      if (record.approval) return;\n      emitOnce({\n        key: `approval:${record.id}`,\n        part: {\n          type: 'tool-approval-request',\n          approvalId: record.approvalId,\n          toolCallId: record.id,\n        },\n      });\n    }\n    function emitToolResult(record: FxToolRecord) {\n      emitOnce({\n        key: `result:${record.id}`,\n        part: {\n          type: 'tool-result',\n          toolCallId: record.id,\n          toolName: record.name,\n          result: fxJsonValue(record.output) ?? '',\n          isError: record.result?.isError,\n          ...(record.name.startsWith('mcp_') ? { dynamic: true } : {}),\n        },\n      });\n    }\n    /*\n     * libfx invokes host executors sequentially. Publishing the complete\n     * recorded model batch before those callbacks lets the host collect all\n     * approvals without waiting for an earlier call to finish executing.\n     */\n    async function publishToolBatch(input: { requestIndex: number }) {\n      signal.throwIfAborted();\n      const batch: Array<{ record: FxToolRecord; tool: FxRegisteredTool }> = [];\n      for (const call of translator.toolCalls.get(input.requestIndex) ?? []) {\n        const tool = registeredTools.get(call.toolName);\n        if (!tool) continue;\n        let value: unknown;\n        try {\n          value =\n            typeof call.input === 'string'\n              ? secureJsonParse(call.input)\n              : call.input;\n        } catch {\n          continue;\n        }\n        if (value == null || typeof value !== 'object' || Array.isArray(value))\n          continue;\n        const record = getToolRecord({\n          id: call.toolCallId,\n          name: call.toolName,\n          value,\n        });\n        toolRequests.set(record.id, input.requestIndex);\n        batch.push({ record, tool });\n      }\n      await save();\n      signal.throwIfAborted();\n      for (const { record, tool } of batch) {\n        emitToolCall({ record, providerExecuted: tool.providerExecuted });\n        if (\n          record.status !== 'completed' &&\n          tool.providerExecuted &&\n          fxToolRequiresApproval({\n            permissionMode: startOpts.permissionMode ?? 'allow-all',\n            kind: tool.kind,\n          })\n        ) {\n          emitToolApproval(record);\n        }\n      }\n    }\n    async function executeTool(input: {\n      tool: FxTool;\n      value: unknown;\n      providerExecuted: boolean;\n      kind: 'readonly' | 'edit' | 'bash';\n    }): Promise<FxToolResult> {\n      signal.throwIfAborted();\n      const identity = identities[callbackIndex++];\n      if (!identity || identity.name !== input.tool.name)\n        throw new Error(\n          'fx tool callback could not be matched to its original call ID.',\n        );\n      const current = getToolRecord({\n        id: identity.id,\n        name: input.tool.name,\n        value: input.value,\n      });\n      emitToolCall({\n        record: current,\n        providerExecuted: input.providerExecuted,\n      });\n      if (current.status !== 'completed') {\n        await save();\n        if (current.status === 'executing') {\n          current.result = {\n            type: 'libfx.tool-result',\n            text: 'This tool execution was interrupted and its outcome is unknown. It was not executed again. Inspect the sandbox before retrying.',\n            images: [],\n            isError: true,\n          };\n          current.output = current.result.text;\n        } else if (!input.providerExecuted) {\n          if (!results.has(current.id)) earlyStep(current);\n          const submission = await waitFor(() => results.get(current.id));\n          current.result = toFxToolResult(submission);\n          current.output = fxJsonVal