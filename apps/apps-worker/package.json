{
  "name": "@patchsmith/apps-worker",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "check-types": "tsc --noEmit",
    "types": "wrangler types src/worker-env.d.ts --env-interface Env --strict-vars=false",
    "dev": "wrangler dev --local --persist-to .patchsmith/state",
    "test": "vp test run",
    "deploy": "wrangler deploy",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/experimental-effect": "2.0.0-beta.40",
    "@orpc/hibernation": "2.0.0-beta.40",
    "@orpc/server": "catalog:",
    "@patchsmith/api-utils": "workspace:*",
    "@patchsmith/app": "workspace:*",
    "@patchsmith/app-db": "workspace:*",
    "@patchsmith/asset-delivery": "workspace:*",
    "@standard-server/peer": "0.10.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "workerd": "1.20261010.1",
    "wrangler": "4.149.0"
  },
  "engines": {
    "node": ">=24"
  }
}
