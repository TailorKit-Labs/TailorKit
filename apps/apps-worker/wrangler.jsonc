{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patchsmith-apps-worker",
  "main": "src/index.ts",
  "build": {
    "command": "pnpm exec turbo run build --filter=@patchsmith/apps-worker^... && node scripts/build-bootstrap.mjs",
    "watch_dir": [
      "src",
      "scripts",
      "../../packages/api-utils/src",
      "../../packages/app/src",
      "../../packages/app-db/src",
      "../../packages/asset-delivery/src",
    ],
  },
  "compatibility_date": "2026-10-01",
  "rules": [
    {
      "type": "Text",
      "globs": ["**/bootstrap.txt"],
      "fallthrough": true,
    },
  ],
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "placement": {
    "region": "aws:us-east-1",
  },
  "routes": [
    { "pattern": "*.tailorkit.app/*", "zone_name": "tailorkit.app" },
    { "pattern": "internal.tailorkit.app", "custom_domain": true },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "patchsmith-app-assets-prod",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STORES",
        "class_name": "PatchsmithAppInstallation",
      },
    ],
  },
  "exports": {
    "AppInstallation": {
      "type": "durable-object",
      "state": "deleted",
    },
    "PatchsmithAppInstallation": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "secrets": {
    "required": ["RUNTIME_SERVICE_TOKEN"],
  },
  "vars": {
    "ASSET_DOMAIN": "tailorkit.app",
    "PLATFORM_URL": "https://patchsmith.io/api/platform",
    "APP_RUNTIME_PUBLIC_KEYS": {
      "keys": [
        {
          "kty": "EC",
          "x": "DRoS0JGTeeemauZNCaf6OCD2cD7e0gFdynlz8X6lplE",
          "y": "jj8QXZ_WHKX89qF9Yo6fn5yo470zjE9uknZ30jja11s",
          "crv": "P-256",
          "kid": "patchsmith-runtime-2026-10-23",
          "alg": "ES256",
          "use": "sig",
        },
        {
          "kty": "EC",
          "x": "mNmgu9uJ_4uRcvrwoxwqVRGKE5glJsoTz-GSDDYKqkI",
          "y": "Snkr5Pv_fXPHV2qROt2heEK-EWWps-tIjtVnJMIZIgQ",
          "crv": "P-256",
          "kid": "patchsmith-runtime-2026-10-20",
          "alg": "ES256",
          "use": "sig",
        },
      ],
    },
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },

}
