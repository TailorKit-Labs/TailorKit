{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patchsmith-icons-assets",
  "main": "src/fallback.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "pnpm exec turbo run build --filter=@patchsmith/core... && node scripts/build-assets.mjs",
    "watch_dir": ["scripts", "public", "src"],
  },
  "assets": {
    "directory": "dist",
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [
    { "pattern": "icons.tailorkit.app", "custom_domain": true },
    { "pattern": "icons.tailorkit.app/*", "zone_name": "tailorkit.app" },
  ],
}
