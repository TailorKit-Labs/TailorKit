{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PatchSmith",
  "colors": {
    "primary": "#18181B",
    "light": "#FAFAFA",
    "dark": "#00a6f4"
  },
  "favicon": {
    "light": "/images/mark-background-light.svg",
    "dark": "/images/mark-background-dark.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "getting-started/introduction",
          "getting-started/installation"
        ]
      },
      {
        "group": "App Capabilities",
        "pages": [
          "concepts/slots",
          "concepts/views",
          "concepts/components",
          "concepts/tools"
        ]
      },
      {
        "group": "Writing apps",
        "pages": ["writing-apps/overview", "writing-apps/ui"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Pricing",
          "href": "https://patchsmith.io/pricing",
          "icon": "money-bills-simple"
        },
        {
          "anchor": "Talk to a founder",
          "href": "https://cal.com/alfiejones",
          "icon": "phone"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo-with-text-light.svg",
    "dark": "/images/logo-with-text-dark.svg",
    "href": "https://patchsmith.io/home"
  },
  "navbar": {
    "links": [
      {
        "href": "/login",
        "label": "login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://patchsmith.io/signup"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TailorKit-Labs/tailorkit"
    }
  },
  "description": "PatchSmith lets users, AI, and partners build extensions inside your SaaS. Those extensions run in a sandbox and use the components, data, and tools you choose to expose.",
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#111111"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "metadata": {
    "timestamp": false
  }
}
