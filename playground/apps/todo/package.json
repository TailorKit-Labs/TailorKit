{
  "name": "@playground/todo",
  "private": true,
  "type": "module",
  "imports": {
    "#patchsmith": "./src/patchsmith.gen.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "generate": "patchsmith generate --schema ../../schema.json",
    "build": "vp build",
    "check-types": "tsc --noEmit",
