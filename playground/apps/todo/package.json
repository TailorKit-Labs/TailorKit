    "format": "vp fmt --check",
    "check": "vp check",
    "fix": "vp check --fix",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "patchsmith": "workspace:*",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@patchsmith/cli": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
