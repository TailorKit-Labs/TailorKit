{
  "name": "@patchsmith/kv",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/kv.ts src/redis.ts src/upstash.ts src/types.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@patchsmith/env": "workspace:*",
    "@patchsmith/observability": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "@upstash/redis": "^1.39.0",
    "ioredis": "^6.0.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@upstash/redis": "^1.34.0",
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@upstash/redis": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
