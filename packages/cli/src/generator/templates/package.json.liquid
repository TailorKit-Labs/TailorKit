{
  "name": "{{ packageName }}",
  "description": "A TailorKit.dev app that embeds in a host app to extend what it can do.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#tailorkit": "./src/tailorkit.gen.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "scripts": {
    "build": "{% if vitePlus %}vp{% else %}vite{% endif %} build",
    "db:generate": "tailorkit db generate",
    "deploy": "tailorkit deploy",
    "generate": "tailorkit generate"{% if vitePlus %},
    "lint": "vp lint",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test"{% endif %}
  },
  "dependencies": {
    "tailorkit": "{{ tailorkitVersion }}",
    "preact": "{{ preactVersion }}",
    "valibot": "{{ valibotVersion }}"
  },
  "devDependencies": {
    "drizzle-kit": "{{ drizzleKitVersion }}",
    "drizzle-orm": "{{ drizzleOrmVersion }}",
    "typescript": "{{ typescriptVersion }}",
    "vite": "{% if vitePlus %}npm:@voidzero-dev/vite-plus-core@{{ vitePlusVersion }}{% else %}{{ viteVersion }}{% endif %}"{% if vitePlus %},
    "vite-plus": "{{ vitePlusVersion }}"{% endif %}
  },
  "type": "module"
}
