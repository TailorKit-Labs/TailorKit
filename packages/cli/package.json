{
  "name": "@tailorkit/cli",
  "version": "0.1.0-beta.43",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TailorKit-Labs/TailorKit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "tailor": "./bin/tailorkit.js",
    "tailorkit": "./bin/tailorkit.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ],
    "#package.json": "./package.json"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/tui": "1.0.138",
    "@clack/prompts": "^1.8.1",
    "@orpc/client": "catalog:",
    "@tailorkit/client-platform": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/vite": "workspace:*",
    "ai": "catalog:",
    "cac": "^7.0.1",
    "jose": "6.2.12",
    "liquidjs": "^10.30.0",
    "picocolors": "^1.1.1",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/app": "workspace:*",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "preact": "^11.0.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
