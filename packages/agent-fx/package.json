{
  "name": "@tailorkit/agent-fx",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./workflows": {
      "types": "./dist/workflows.d.mts",
      "import": "./src/workflows.ts"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/workflows.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.154",
    "@ai-sdk/harness-fx": "1.0.69",
    "@ai-sdk/sandbox-vercel": "1.0.154",
    "@ai-sdk/workflow-harness": "1.0.154",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@tailorkit/vite": "workspace:*",
    "@vercel/oidc": "3.5.0",
    "@vercel/sandbox": "3.6.1",
    "ai": "catalog:fx",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:",
    "workflow": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
