{
  "name": "@tailorkit/core",
  "version": "0.1.0-beta.47",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TailorKit-Labs/TailorKit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#env": "./src/env.ts",
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "types": [
        "./dist/*",
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "default": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ]
    }
  },
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server.js"
    },
    "./server/types": {
      "types": "./dist/server/types.d.ts",
      "import": "./dist/server-types.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "import": "./dist/spec.js"
    },
    "./primitives/theme": {
      "types": "./dist/primitives/theme.d.ts",
      "import": "./dist/primitives-theme.js"
    },
    "./primitives/zod": {
      "types": "./dist/primitives/zod.d.ts",
      "import": "./dist/primitives-zod.js"
    },
    "./primitives/valibot": {
      "types": "./dist/primitives/valibot.d.ts",
      "import": "./dist/primitives-valibot.js"
    },
    "./primitives/arktype": {
      "types": "./dist/primitives/arktype.d.ts",
      "import": "./dist/primitives-arktype.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --entry.views src/views.ts --entry.server src/server/index.ts --entry.server-types src/server/types.ts --entry.schema src/schema/index.ts --entry.spec src/spec/index.ts --entry.primitives-theme src/primitives/theme.ts --entry.primitives-zod src/primitives/zod.ts --entry.primitives-valibot src/primitives/valibot.ts --entry.primitives-arktype src/primitives/arktype.ts --format esm --target node20 --clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "generate:native": "tsx scripts/generate-native-components/index.ts",
    "test": "vp test run --typecheck --exclude '**/*.test-d.ts'",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@standard-schema/spec": "^1.1.0",
    "@tailorkit/client-platform": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@orpc/openapi": "catalog:",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "@valibot/to-json-schema": "^1.8.0",
    "ai": "catalog:",
    "arktype": "^2.2.8",
    "tsup": "^8.5.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "arktype": ">=2.1.0",
    "valibot": ">=1.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "arktype": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
