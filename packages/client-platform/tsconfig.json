{
  "extends": "@patchsmith/config/tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "lib": ["ESNext", "DOM"],
    "sourceMap": true,
    "outDir": "dist",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "composite": true,
    "strictNullChecks": true,
    "allowJs": true,
    "paths": {
      "#*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", "test"]
}
