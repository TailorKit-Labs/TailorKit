{
  "name": "@patchsmith/auth",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/lib/captcha-endpoints.ts src/lib/email.ts src/lib/permissions.ts src/lib/tenant-short-id.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "generate": "auth generate --config src/index.ts --output ../db/src/schema/auth.generated.ts --yes",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@better-auth/infra": "^0.4.17",
    "@better-auth/passkey": "1.7.7",
    "@patchsmith/db": "workspace:*",
    "@patchsmith/email": "workspace:*",
    "@patchsmith/env": "workspace:*",
    "@patchsmith/kv": "workspace:*",
    "@patchsmith/observability": "workspace:*",
    "@simplewebauthn/server": "^13.3.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "catalog:",
    "botid": "1.5.11",
    "jose": "6.2.12",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "auth": "1.7.7",
    "typescript": "catalog:"
  }
}
