{
  "name": "@tailorkit/react",
  "version": "0.1.0-beta.52",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TailorKit-Labs/TailorKit.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "types": [
        "./dist/*",
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "default": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@nanostores/react": "2.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@tailorkit/app": "workspace:*",
    "@tailorkit/client-core": "workspace:*",
    "@tailorkit/client-platform": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/sandbox": "workspace:*",
    "nanostores": "1.5.5"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "happy-dom": "^20.14.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
