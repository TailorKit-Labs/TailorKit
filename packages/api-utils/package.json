{
  "name": "@patchsmith/api-utils",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./rate-limiting": {
      "development": "./src/rate-limiting.ts",
      "types": "./dist/rate-limiting.d.mts",
      "default": "./dist/rate-limiting.mjs"
    },
    "./hashing": {
      "development": "./src/hashing.ts",
      "types": "./dist/hashing.d.mts",
      "default": "./dist/hashing.mjs"
    },
    "./dev-delay": {
      "development": "./src/dev-delay.ts",
      "types": "./dist/dev-delay.d.mts",
      "default": "./dist/dev-delay.mjs"
    },
    "./app-asset-url": {
      "development": "./src/app-asset-url.ts",
      "types": "./dist/app-asset-url.d.mts",
      "default": "./dist/app-asset-url.mjs"
    },
    "./app-auth": {
      "development": "./src/app-auth.ts",
      "types": "./dist/app-auth.d.mts",
      "default": "./dist/app-auth.mjs"
    },
    "./agent-token": {
      "development": "./src/agent-token.ts",
      "types": "./dist/agent-token.d.mts",
      "default": "./dist/agent-token.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/rate-limiting.ts src/hashing.ts src/dev-delay.ts src/app-asset-url.ts src/app-auth.ts src/agent-token.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@orpc/ratelimit": "catalog:",
    "@orpc/server": "catalog:",
    "@patchsmith/app": "workspace:*",
    "@patchsmith/env": "workspace:*",
    "@patchsmith/kv": "workspace:*",
    "@patchsmith/observability": "workspace:*",
    "@upstash/ratelimit": "^2.2.0",
    "@vercel/functions": "^3.9.11",
    "effect": "catalog:",
    "jose": "6.2.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
