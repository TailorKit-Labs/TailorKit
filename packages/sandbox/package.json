{
  "name": "@patchsmith/sandbox",
  "version": "0.1.0-beta.49",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TailorKit-Labs/TailorKit.git",
    "directory": "packages/sandbox"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "build": "vp build && tsc -p tsconfig.build.json",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@patchsmith/app": "workspace:*",
    "@patchsmith/core": "workspace:*",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "happy-dom": "^20.14.6",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
