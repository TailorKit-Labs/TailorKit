{
  "name": "@patchsmith/flags",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@vercel/flags-core": "1.10.0"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
