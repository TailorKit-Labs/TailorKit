{
  "name": "@tailorkit/agent",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ],
    "#sandbox": "./src/sandbox.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./workflows": {
      "types": "./dist/workflows.d.mts",
      "import": "./src/workflows.ts"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./source-export": {
      "development": "./src/source-export.ts",
      "types": "./dist/source-export.d.mts",
      "default": "./dist/source-export.mjs"
    },
    "./threads": {
      "types": "./dist/threads.d.mts",
      "import": "./dist/threads.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./workflow-support": {
      "types": "./dist/workflow-support.d.mts",
      "import": "./src/workflow-support.ts"
    }
  },
  "scripts": {
    "build": "vp pack src/threads.ts src/index.ts src/workflows.ts src/mcp.ts src/source-export.ts src/runtime.ts src/workflow-support.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.154",
    "@ai-sdk/harness-pi": "1.0.156",
    "@ai-sdk/sandbox-vercel": "1.0.154",
    "@ai-sdk/workflow-harness": "1.0.154",
    "@modelcontextprotocol/server": "2.3.1",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/vite": "workspace:*",
    "@vercel/oidc": "3.5.0",
    "@vercel/sandbox": "3.6.1",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "valibot": "catalog:",
    "workflow": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
