{
  "name": "@patchsmith/email",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./templates": {
      "development": "./src/templates.ts",
      "types": "./dist/templates.d.mts",
      "default": "./dist/templates.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/templates.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "dev": "email dev --dir src/templates --port 3003",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@patchsmith/env": "workspace:*",
    "@patchsmith/observability": "workspace:*",
    "@react-email/render": "^2.1.1",
    "nodemailer": "^10.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@patchsmith/config": "workspace:*",
    "@react-email/ui": "6.11.3",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
