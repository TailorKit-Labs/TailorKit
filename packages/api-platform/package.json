{
  "name": "@tailorkit/api-platform",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./openapi": {
      "default": "./openapi.json"
    },
    "./context": {
      "development": "./src/context.ts",
      "types": "./dist/context.d.mts",
      "default": "./dist/context.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/app-agent-mcp.ts src/runtime/auth.ts src/context.ts src/pagination.ts src/procedures.ts src/cli-token.ts src/asset-url.ts src/assets.ts src/scope.ts src/routes/apps.ts src/routes/runtime.ts src/routes/cli-auth.ts src/routes/deployments.ts src/routes/app-agent.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "generate:openapi": "node --conditions=development --import tsx scripts/generate-openapi.ts && vp fmt openapi.json",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@tailorkit/agent": "workspace:*",
    "@tailorkit/agent-fx": "workspace:*",
    "@tailorkit/api-utils": "workspace:*",
    "@tailorkit/app": "workspace:*",
    "@tailorkit/asset-delivery": "workspace:*",
    "@tailorkit/auth": "workspace:*",
    "@tailorkit/db": "workspace:*",
    "@tailorkit/env": "workspace:*",
    "@tailorkit/kv": "workspace:*",
    "@tailorkit/observability": "workspace:*",
    "@tailorkit/storage": "workspace:*",
    "ai": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "workflow": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
