{
  "name": "@tailorkit/app-agent",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./workflows": {
      "types": "./dist/workflows.d.mts",
      "import": "./dist/workflows.mjs"
    },
    "./mcp": {
      "types": "./dist/mcp.d.mts",
      "import": "./dist/mcp.mjs"
    },
    "./source-export": {
      "development": "./src/source-export.ts",
      "types": "./dist/source-export.d.mts",
      "default": "./dist/source-export.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/workflows.ts src/mcp.ts src/source-export.ts --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@ai-sdk/workflow": "2.0.69",
    "@modelcontextprotocol/server": "2.3.1",
    "@vercel/sandbox": "3.6.1",
    "ai": "catalog:",
    "workflow": "5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
