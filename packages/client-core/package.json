{
  "name": "@tailorkit/client-core",
  "version": "0.1.0-beta.50",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TailorKit-Labs/TailorKit.git",
    "directory": "packages/client-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#env": "./src/env.ts",
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "types": [
        "./dist/*",
        "./dist/*.d.ts",
        "./dist/*/index.d.ts"
      ],
      "default": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    },
    "./store/fetch": {
      "types": "./dist/store/fetch/index.d.ts",
      "import": "./dist/store-fetch.js"
    },
    "./store/local": {
      "types": "./dist/store/local/index.d.ts",
      "import": "./dist/store-local.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.client src/client/index.ts --entry.store-fetch src/store/fetch/index.ts --entry.store-local src/store/local/index.ts --format esm --target node20 --clean && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@nanostores/async": "0.1.0",
    "@tailorkit/app": "workspace:*",
    "@tailorkit/core": "workspace:*",
    "@tailorkit/sandbox": "workspace:*",
    "nanostores": "1.5.5",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@tailorkit/config": "workspace:*",
    "@types/node": "catalog:",
    "tsup": "^8.5.1",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
