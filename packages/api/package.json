{
  "name": "@patchsmith/api",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "imports": {
    "#env": "./src/env.ts",
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "development": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "vp pack src/index.ts src/context.ts src/procedures.ts src/routers/index.ts src/routers/apps.ts src/routers/org.ts src/routers/project.ts src/routers/user.ts --target node24 --format esm --dts --clean",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint .",
    "lint:fix": "vp lint --fix ."
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "@patchsmith/agent": "workspace:*",
    "@patchsmith/api-utils": "workspace:*",
    "@patchsmith/auth": "workspace:*",
    "@patchsmith/db": "workspace:*",
    "@patchsmith/env": "workspace:*",
    "@patchsmith/flags": "workspace:*",
    "@patchsmith/kv": "workspace:*",
    "@patchsmith/observability": "workspace:*",
    "@vercel/functions": "^3.10.1",
    "drizzle-orm": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@patchsmith/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11"
  }
}
